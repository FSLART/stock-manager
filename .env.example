# Copy to .env and enter the database credentials created in aaPanel.
DB_BACKEND=mysql
STORAGE_MODE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stocklart
MYSQL_USER=stocklart
MYSQL_PASSWORD=

# For a database on another server, change MYSQL_HOST above.
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
