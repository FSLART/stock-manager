# Copy to .env and enter the database credentials created in aaPanel.
DB_BACKEND=mysql
STORAGE_MODE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stocklart
MYSQL_USER=stocklart
MYSQL_PASSWORD=

# For a database on another server, change MYSQL_HOST above.

# Login: signs the session cookies (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=
PUBLIC_BASE_URL=https://stocklart.pt
# Optional Notion login (public integration, redirect URI ${PUBLIC_BASE_URL}/api/auth/notion/callback).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion workspace whose members are added automatically on their first login.
NOTION_WORKSPACE_ID=
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# Optional: after a label scan, fill description, category, datasheet, image and current price from the P/N.
# Mouser Search API key: https://www.mouser.com/api-hub/ · DigiKey (Product Information v4, production app): https://developer.digikey.com
# DigiKey also supplies the image (Mouser blocks image downloads from servers).
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
