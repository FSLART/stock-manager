# Copy to .env and enter the database credentials created in aaPanel.
DB_BACKEND=mysql
STORAGE_MODE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stocklart
MYSQL_USER=stocklart
MYSQL_PASSWORD=

# For a database on another server, change MYSQL_HOST above.

# Login: signs the session cookies (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=
PUBLIC_BASE_URL=https://stocklart.pt
# Optional Notion login (public integration, redirect URI ${PUBLIC_BASE_URL}/api/auth/notion/callback).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion workspace whose members are added automatically on their first login.
NOTION_WORKSPACE_ID=
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
